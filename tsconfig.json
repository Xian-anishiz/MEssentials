{
  "compilerOptions": {
    "moduleResolution": "bundler",
    "target": "es2022",
    "module": "esnext",
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "types": ["svelte", "@sveltejs/kit"]
  },
  "include": ["src/**/*"],
  "extends": "./.svelte-kit/tsconfig.json"
}

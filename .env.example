# MEssentials local development environment
# Copy to .env and fill only the values required for your task.

# App
PUBLIC_APP_URL=http://localhost:5173
NODE_ENV=development
SESSION_SECRET=
ALLOWED_EMAIL_DOMAINS=up.edu.ph

# Supabase PostgreSQL (use pooled URLs; never the direct database host)
# Runtime: transaction pooler, port 6543
DATABASE_URL=
# Migrations: session pooler, port 5432 on the pooler host
DATABASE_URL_MIGRATE=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare Turnstile
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PRESIGN_TTL_SECONDS=300

# Web Push (VAPID)
PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Background worker
WORKER_POLL_INTERVAL_MS=3000
WORKER_CONCURRENCY=3
WORKER_DB_POOL_MAX=5

# Upload limits (bytes)
MAX_UPLOAD_PDF_BYTES=52428800
MAX_UPLOAD_IMAGE_BYTES=52428800

# Business rules
MAX_ACTIVE_LOANS=5
MAX_LOAN_DAYS=7
BORROW_REMINDER_LEAD_DAYS=2
REGISTRATION_ALERT_POSITION=1

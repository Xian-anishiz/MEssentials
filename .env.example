# MEssentials Environment Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control - it contains secrets!

# =============================================================================
# APP CONFIGURATION
# =============================================================================

# The base URL of your application (used for API URLs, session cookies, etc.)
# Example: https://messentials.vercel.app
PUBLIC_APP_URL=http://localhost:5173

# Node environment: 'development', 'production', or 'test'
NODE_ENV=development

# Secret key for signing session cookies (must be a 32+ character random string)
# Generate one: openssl rand -base64 32
SESSION_SECRET=

# Allowed email domain for sign-up (defaults to 'up.edu.ph')
# Only verified Google accounts from this domain can create accounts.
ALLOWED_EMAIL_DOMAINS=up.edu.ph

# =============================================================================
# DATABASE CONFIGURATION (Supabase)
# =============================================================================

# In supabase click connect in the top middle part of the page
# select direct connection -> transaction pooler -> type: URI -> copy connection string -> put in DATABASE_URL
# select direct connection -> session pooler -> type: URI -> copy connection string -> put in DATABASE_URL_MIGRATE

# Transaction pooler connection (for runtime app queries)
# Port: 6543 - This is the pooler used by the live application
DATABASE_URL=

# Session pooler connection (for migrations)
# Port: 5432 - Use this for running drizzle migrations
DATABASE_URL_MIGRATE=

# =============================================================================
# AUTHENTICATION
# =============================================================================

# Google OAuth credentials
# Get these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =============================================================================
# SECURITY & RATE LIMITING
# =============================================================================

# Cloudflare Turnstile site key (public)
# Get from https://dashboard.cloudflare.com/
PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare Turnstile secret key (private)
TURNSTILE_SECRET_KEY=

# =============================================================================
# FILE STORAGE (Cloudflare R2)
# =============================================================================

# R2 account ID (find in Cloudflare dashboard → R2 → Your bucket)
R2_ACCOUNT_ID=

# R2 access key (create in Cloudflare API Tokens)
R2_ACCESS_KEY_ID=

# R2 secret access key
R2_SECRET_ACCESS_KEY=

# R2 bucket name (create in Cloudflare R2)
R2_BUCKET=

# Presigned URL time-to-live in seconds (default: 300 = 5 minutes)
R2_PRESIGN_TTL_SECONDS=300

# =============================================================================
# WEB PUSH NOTIFICATIONS
# =============================================================================

# VAPID public key (base64 URL-encoded, get from web-push CLI)
PUBLIC_VAPID_PUBLIC_KEY=

# VAPID private key (keep this SECRET!)
VAPID_PRIVATE_KEY=

# VAPID subject (mailto: or https: URL for push subscription)
# Example: mailto:mevolcorps@example.org
VAPID_SUBJECT=

# =============================================================================
# BACKGROUND WORKER
# =============================================================================

# How often the worker polls for jobs (milliseconds)
WORKER_POLL_INTERVAL_MS=3000

# Maximum concurrent jobs the worker will process
WORKER_CONCURRENCY=3

# Maximum database connections for the worker pool
WORKER_DB_POOL_MAX=5

# =============================================================================
# UPLOAD LIMITS (bytes)
# =============================================================================

# Maximum PDF upload size (default: 52428800 = 50 MB)
MAX_UPLOAD_PDF_BYTES=52428800

# Maximum image upload size for products, events, reviewers, etc.
MAX_UPLOAD_IMAGE_BYTES=52428800

# =============================================================================
# BUSINESS RULES (changeable operational definitions)
# =============================================================================

# Maximum active loans a student can have at once
MAX_ACTIVE_LOANS=

# Maximum loan duration in days
MAX_LOAN_DAYS=

# Days before due date to send reminder (for overdue notifications)
BORROW_REMINDER_LEAD_DAYS=

# Position in queue to trigger "you're next" push alert (1 = immediate)
REGISTRATION_ALERT_POSITION=1
